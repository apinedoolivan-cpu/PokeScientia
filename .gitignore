# No leading slashes: these rules apply in any folder (root, frontend/, backend/).
# Lockfiles (package-lock.json, go.sum) are intentionally NOT ignored — commit them.

# Dependencies
node_modules/

# Angular build output and caches
dist/
out-tsc/
.angular/
coverage/
*.tsbuildinfo

# Test output
test-results/
playwright-report/

# Environment and secrets (keep an example file)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editors (keep shared VS Code settings if you want them versioned)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
tmp/
*.tmp

# Go backend (Phase 5)
backend/bin/
*.exe